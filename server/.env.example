PORT=8000
MONGODB_URI=mongodb://localhost:27017/ridgeline
JWT_SECRET=change-me-in-production
ANTHROPIC_API_KEY=sk-ant-...
USDA_FDC_API_KEY=DEMO_KEY
AI_FEATURES_ENABLED=true
CORS_ORIGIN=http://localhost:5173

# Keycloak (step 9.2) — set these to switch from local JWTs to Keycloak RS256 tokens.
# In Docker these are injected by docker-compose.yml; for local dev leave them unset.
# KEYCLOAK_JWKS_URI=http://localhost:8080/realms/Ridgeline/protocol/openid-connect/certs
# KEYCLOAK_ISSUER=http://localhost:8080/realms/Ridgeline